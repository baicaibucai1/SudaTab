{
  "manifest_version": 3,
  "name": "SudaTab",
  "version": "0.2.1",
  "description": "SudaTab · 网格化新标签页：图标、时钟、搜索框都是可拖动的方块。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "favicon"
  ],
  "minimum_chrome_version": "104"
}
